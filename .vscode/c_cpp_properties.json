{
    "version": 4,
    "configurations": [
        {
            "name": "MSVC x64",
            "intelliSenseMode": "windows-msvc-x64",
            "cStandard": "c17",
            "cppStandard": "c++latest",
            "compileCommands": [
                "${workspaceFolder}/build/debug/compile_commands.json"
            ],
            "includePath": [
                "${workspaceFolder}/headers",
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/debug/_deps/sdl3-src/include",
                "${workspaceFolder}/build/debug/_deps/imgui-src",
                "${workspaceFolder}/build/debug/_deps/imgui-src/backends"
            ]
        }
    ]
}
